


<% if flash[:notice] %>
  <div class="notice" "data-turbolinks": "false"><h2><%= flash[:notice] %> </h2></div>
<% end %>
<h1>Edit Menu Images</h1>
<!-- picture menu -->
<div class="section-block">
<h1>Menu</h1>
    <div class="info-grid">
    <% @current_menu.each_with_index do |mname, index|%>
        <article class="info-card">
        <p class="event-date"><%= MenuController::MENU_NAME[index] %></p>
        <%= link_to menu_image_path(menuname: mname), class: "event-image-link" do %>
            <%= image_tag "/menu/#{mname}", alt: "menu front", class: "event-image" %>
        <% end %>
        </article>
    <% end %>
    </div>
</div>





    <%= form_with url: menu_create_path, method: :post,  local: true do |form| %>
    <div>
        <h4>Front Menu Image</h4>
        <%= form.hidden_field :image_name_front, value: MenuController::MENU_NAME[0] %>
        <%= form.label :image, "Upload Front Menu Image" %></br>
        <%= form.file_field :image_menu_front %>
    </div>
    <div>
        <h4>Rear Menu Image</h4>
        <%= form.hidden_field :image_name_rear, value: MenuController::MENU_NAME[1]  %>
        <%= form.label :image, "Upload Back Menu Image" %></br>
        <%= form.file_field :image_menu_rear %>
    </div>
        <div>
        <h4>Spirit Menu Front Image</h4>
        <%= form.hidden_field :image_name_brunch, value: MenuController::MENU_NAME[2] %>
        <%= form.label :image, "Upload Brunch Menu Image" %></br>
        <%= form.file_field :image_brunch %>
    </div>
        <div>
            <h4>Spirit Menu Rear Image</h4>
        <%= form.hidden_field :image_name_spirit, value: MenuController::MENU_NAME[3]  %>
        <%= form.label :image, "Upload Spirit Menu Image" %></br>
        <%= form.file_field :image_spirit %>
    </div>
    <%= form.submit "Save" %>
    <% end %>

<br/>

<%= button_to "Log Out", logout_path, method: :delete %>