<% content_for :title, "Menu | Lucky Liquor" %>

<section class="content-page">

  <div class="section-block">
    <h1>Menu</h1>
    <p class="center-text ">Solid pours, easygoing service, and a dive-bar menu designed for good company and no fuss.</p>
      <div class="info-grid">
        <% @current_menu.each_with_index do |mname, index|%>
          <article class="info-card">
            <p class="menu-label"><%= MenuController::MENU_NAME[index] %></p>
            <%= link_to menu_image_path(menuname: mname), class: "menu-image-link" do %>
              <%= image_tag "/menu/#{mname}", alt: "menu front", class: "menu-image" %>
            <% end %>
          </article>
        <% end %>
      </div>
  </div>
    <div class="info-grid">
      <article class="info-card">
        <h3>Vibe</h3>
        <p>Laid-back, no-frills, and made for quick hangs, long nights, and repeat visits.</p>
      </article>
      <article class="info-card">
        <h3>Drinks</h3>
        <ul>
          <li>Stiff pours</li>
          <li>Well whiskey</li>
          <li>Classic cocktails</li>
          <li>Beer and easy favorites</li>
        </ul>
      </article>
      <article class="info-card">
        <h3>Hours</h3>
        <p>Open late most nights, with the best energy hitting the weekends.</p>
      </article>
    </div>
  </div>
</section>
