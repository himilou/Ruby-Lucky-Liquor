<% content_for :title, "Menu | Lucky Liquor" %>

<section class="content-page">
  <div class="section-block">
    <h1>Menu</h1>
    <p class="center-text ">Solid pours, easygoing service, and a dive-bar menu designed for good company and no fuss.</p>
    <!-- picture menu -->
        <div class="info-grid">
      <article class="info-card">
         <%= link_to menu_image_path(menuname: "menufront.jpg"), class: "event-image-link" do %>
            <%= image_tag "/menu/menufront.jpg", alt: "menu front", class: "event-image" %>
          <% end %>
      </article>
      <article class="info-card">
          <%= link_to menu_image_path(menuname: "menurear.jpg"), class: "event-image-link" do %>
            <%= image_tag "/menu/menurear.jpg", alt: "menu back", class: "event-image" %>
          <% end %>
      </article>
         <article class="info-card">
         <%= link_to menu_image_path(menuname: "spiritfront.jpg"), class: "event-image-link" do %>
            <%= image_tag "/menu/spiritfront.jpg", alt: "spirits menu front", class: "event-image" %>
          <% end %>
      </article>
      <article class="info-card">
          <%= link_to menu_image_path(menuname: "spiritrear.jpg"), class: "event-image-link" do %>
            <%= image_tag "/menu/spiritrear.jpg", alt: "spirits menu back", class: "event-image" %>
          <% end %>
      </article>
    </div>
  </div>
    <div class="info-grid">
      <article class="info-card">
        <h3>Vibe</h3>
        <p>Laid-back, no-frills, and made for quick hangs, long nights, and repeat visits.</p>
      </article>
      <article class="info-card">
        <h3>Drinks</h3>
        <ul>
          <li>Stiff pours</li>
          <li>Well whiskey</li>
          <li>Classic cocktails</li>
          <li>Beer and easy favorites</li>
        </ul>
      </article>
      <article class="info-card">
        <h3>Hours</h3>
        <p>Open late most nights, with the best energy hitting the weekends.</p>
      </article>
    </div>
  </div>
</section>
