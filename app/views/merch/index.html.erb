<h1>T-shirts, Hoodies & More!</h1>


<% content_for :title, "Mechandise | Lucky Liquor" %>

<section class="content-page">
  <div class="section-block">
    <h1>Merchandise</h1>
      <div class="info-grid">
      <% @Products.each do |product| %>
        <article class="info-card">

            <% image_name = product.product_image&.image_filename.presence || "lucky_logo.jpg" %>
            <%= link_to merch_show_path(id: product.id), target: "_blank", rel: "noopener", class: "event-image-link" do%>           
            <%= image_tag image_name, alt: product.product_name, class: "event-image" %>
            <% end %>
          <h5><%= product.product_name %></h5>
          <p><%= product.product_desc %></p>
        </article>
      <% end %>
    </div>
  </div>
  <p class="center-text">Quality Tshirts from Lucky to You!</p>
  
  <div class="info-grid">
      <article class="info-card">
        <h3>Live Music</h3>
        <p>Catch local bands, rotating acts, and community favorites every week in a room built for sound and good company.</p>
      </article>
      <article class="info-card">
        <h3>Pull Tabs</h3>
        <p>Classic bar charm with the quick-hit fun that keeps the whole room buzzing.</p>
      </article>
      <article class="info-card">
        <h3>Atmosphere</h3>
        <p>Friendly staff, friendly regulars, and a laid-back Seattle dive vibe that feels like home.</p>
      </article>
    </div>
</section>
