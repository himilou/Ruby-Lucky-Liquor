<h2> hello from the merch new view </h2>



<%# app/views/products/_form.html.erb %>
<%= form_with(model: @Product, url: merch_create_path, method: :post)  do |form| %>
  <div>
    <%= form.label :product_name %>
    <%= form.text_field :product_name %>
  </div>

  <div>
    <%= form.label :product_desc, "Description" %>
    <%= form.text_field :product_desc%>
  </div>

  <div>
    <%= form.label :images, "Product Images" %>
    <%= form.file_field :images, multiple: true, accept: "image/png, image/jpeg, image/jpg" %>
  </div>
  <%= fields_for :product_image, @ProductImage do |product_image_fields| %>
    <div>
      <%= product_image_fields.label :alt_text %>
      <%= product_image_fields.text_field :alt_text %>
    </div>
    <div>
      <%= product_image_fields.label :is_primary, "Use first image as main image" %>
      <%= product_image_fields.check_box :is_primary %>
    </div>
  <% end %>

  <%= form.submit %>
<% end %>