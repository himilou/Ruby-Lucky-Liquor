<% content_for :title, "Gallery | Lucky Liquor" %>

<section class="content-page">
  <div class="section-block">
    <h1>Gallery</h1>
    <p>Moments from the bar, the crowd, and the live music that keep Lucky Liquor feeling like the old-school neighborhood spot it is.</p>
        
    <div class="gallery-grid">
      <% @image_list.each do |name|%>
        <figure class="gallery-card">
        <%= link_to gallery_image_path(filename: name), class: "event-image-link" do%>
        <%= image_tag name, alt: name, class: "event-image"%>
        <% end %>
        </figure>
      <% end %>
    </div>
  </div>
</section>
