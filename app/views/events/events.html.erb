<% content_for :title, "Events | Lucky Liquor" %>

<section class="content-page">
  <div class="section-block">
    <h1>Events</h1>
      <div class="info-grid">
      <% @event_list.each do |evt| %>
        <article class="info-card">
          <p class="event-date"><%= evt.date %></p>
          <%= link_to events_image_path(filename: evt.filename), target: "_blank", rel: "noopener", class: "event-image-link" do %>
            <%= image_tag "/event_img/#{evt.filename}", alt: evt.bandname, class: "event-image" %>
          <% end %>
          <h5><%= evt.bandname %></h5>
        </article>
      <% end %>
    </div>
  </div>
  <p class="center-text">Lucky Liquor keeps the good times rolling with live music, neighborhood gatherings, and late-night diveside energy.</p>
  
  <div class="info-grid">
      <article class="info-card">
        <h3>Live Music</h3>
        <p>Catch local bands, rotating acts, and community favorites every week in a room built for sound and good company.</p>
      </article>
      <article class="info-card">
        <h3>Pull Tabs</h3>
        <p>Classic bar charm with the quick-hit fun that keeps the whole room buzzing.</p>
      </article>
      <article class="info-card">
        <h3>Atmosphere</h3>
        <p>Friendly staff, friendly regulars, and a laid-back Seattle dive vibe that feels like home.</p>
      </article>
    </div>
</section>
