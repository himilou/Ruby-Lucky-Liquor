

<% if flash[:notice] %>
  <div class="notice" "data-turbolinks": "false"><h2><%= flash[:notice] %> </h2></div>
<% end %>
<div class="hours-main">
    <h2>current hours</h2>
    <ul class="hours" aria-label="current operating hours">
    <% @current.each do |day_of_week| %>
        <li><%= day_of_week['day'] %> - <%= day_of_week['opentime'] %> - <%= day_of_week['closetime'] %></li>
    <% end %>
    </ul>
</div>
<div class="hours-input">
    <%= form_with url: update_hours_path, method: :patch, scope: :hours, local: true do |form| %>
        <table>
            <thead>
            <tr>
                <th>Day</th>
                <th>Open Time</th>
                <th>Close Time</th>
            </tr>
            </thead>
            <tbody>
            <% @form_fields.each do |row| %>
                <tr>
                <td>
                    <strong><%= row['day'] %></strong>
                    <%# Hidden field keeps the day linked to the times on submission %>
                    <%= hidden_field_tag "hours[][day]", row['day'] %>
                </td>
                <td>
                    <%= text_field_tag "hours[][opentime]", row['opentime'], class: "hours-input-narrow" %>
                </td>
                <td>
                    <%= text_field_tag "hours[][closetime]", row['closetime'], class: "hours-input-narrow" %>
                </td>
                </tr>
            <% end %>
            </tbody>
        </table>
    <%= form.submit "Save hours" %>
    <% end %>
</div>

<%= button_to "Log In-Out", change_path, method: :get %>